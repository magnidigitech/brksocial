{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.bhashyamramakrishna.in/api/:path*"
    },
    {
      "source": "/go/:token",
      "destination": "https://api.bhashyamramakrishna.in/go/:token"
    },
    {
      "source": "/instagram/:token",
      "destination": "https://api.bhashyamramakrishna.in/instagram/:token"
    },
    {
      "source": "/whatsapp/:token",
      "destination": "https://api.bhashyamramakrishna.in/whatsapp/:token"
    },
    {
      "source": "/track/:slug/:token",
      "destination": "https://api.bhashyamramakrishna.in/track/:slug/:token"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
